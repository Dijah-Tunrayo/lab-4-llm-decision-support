        "#================================================================================================================#\n",
        "# TODO 3\n",
        "import pandas as pd\n",
        "\n",
        "results = []\n",
        "\n",
        "for letter_id, letter_text in LETTERS.items():\n",
        "  fields = extract_fields(letter_text)\n",
        "  if fields:\n",
        "    fields[\"letter_id\"] = letter_id\n",
        "    results.append(fields)\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "df = df[[\"letter_id\"] + [c for c in df.columns if c != \"letter_id\"]]\n",
        "df\n",
        "\n",
        "\n",
        "#================================================================================================================#"
      ],
