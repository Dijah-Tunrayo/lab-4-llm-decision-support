      "cell_type": "code",
      "source": [
        "from google import genai\n",
        "from google.colab import userdata\n",
        "\n",
        "API_KEY = userdata.get(\"GEMINI_API_KEY\")\n",
        "client = genai.Client(api_key = API_KEY)\n",
        "\n",
        "MODEL = \"gemini-flash-lite-latest\"\n",
        "\n",
        "print(\"Client ready.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "mbk_cS4cGsLo",
        "outputId": "985a102e-d178-42a4-cd56-256d48c44e4c"
      },
      "execution_count": 45,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Client ready.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import time\n",
        "\n",
        "def ask_llm_retry(prompt, temperature=0.7, max_tokens=500, retries=3):\n",
        "    for attempt in range(retries):\n",
        "        try:\n",
        "            return ask_llm(prompt, temperature=temperature, max_tokens=max_tokens)\n",
        "        except Exception as e:\n",
        "            if attempt < retries - 1:\n",
        "                print(f\"Retry {attempt+1}/{retries}... ({e})\")\n",
        "                time.sleep(5)\n",
        "            else:\n",
        "                raise"
      ],
      "metadata": {
        "id": "xjGc2h9_kNkN"
      },
      "execution_count": 46,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**PART 1.1**"
